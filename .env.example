# Envío de correos del formulario de contacto con Resend (https://resend.com)
# En producción se configuran en Vercel → Settings → Environment Variables.
# Para probar en local: copiar este archivo a .env y completar.

# API key de Resend (obligatoria). Nunca subirla al repositorio.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Casilla que recibe las consultas
CONTACT_TO_EMAIL=info@paradigmaseed.com

# Remitente. Debe pertenecer a un dominio verificado en Resend.
# Mientras no se verifique paradigmaseeds.com, usar: Paradigma Seeds <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Paradigma Seeds <contacto@paradigmaseeds.com>
